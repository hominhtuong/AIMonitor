{
  "name": "aimonitor",
  "displayName": "AI Monitor",
  "description": "See every AI process, token, and account limit on your machine, inside VSCode. Runs fully offline.",
  "version": "1.2.3",
  "publisher": "mituultra",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/hominhtuong/AIMonitor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hominhtuong/AIMonitor.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/hominhtuong/AIMonitor/issues"
  },
  "qna": "https://github.com/hominhtuong/AIMonitor/issues",
  "galleryBanner": {
    "color": "#463ccd",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["AI", "Visualization", "Other"],
  "keywords": ["claude", "claude code", "token usage", "ai monitor", "process monitor"],
  "extensionKind": ["workspace", "ui"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Reads only its own bundled files and your local Claude usage data. It never reads or runs workspace code."
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aimon",
          "title": "AI Monitor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aimon": [
        {
          "id": "aimon.dashboardView",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run prepackage && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node scripts/run-tests.js",
    "prepackage": "node scripts/copy-aimon.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "@vscode/vsce": "^2.24.0"
  }
}
